# ScaderRelays-specific overrides (Common sdkconfig.defaults provides the base)

# Bluetooth
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_CRYPTO_STACK_MBEDTLS=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Ethernet (Olimex ESP32-PoE-ISO: internal EMAC + LAN8710 PHY over RMII)
# RMII clock mode/GPIO live in NetworkSettings JSON now (IDF 6.0 dropped the Kconfig options).
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_DMA_BUFFER_SIZE=512
# RX/TX DMA buffer counts trimmed from 10/10 to recover ~5KB internal DMA RAM
# (light traffic on this relay/web/MQTT box). Raise RX again if packet drops appear.
CONFIG_ETH_DMA_RX_BUFFER_NUM=6
CONFIG_ETH_DMA_TX_BUFFER_NUM=4

# lwIP PCB/socket tables trimmed from Common defaults (32/24/8) to recover a few KB
# of heap — a relay + WebServer + MQTT device needs far fewer concurrent TCP PCBs.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=16
CONFIG_LWIP_MAX_LISTENING_TCP=4
